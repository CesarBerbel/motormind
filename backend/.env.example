SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///db.sqlite3

# Desenvolvimento: imprime emails no terminal e evita erro de DNS/SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# Produção: descomente e configure um SMTP real. Não use smtp.example.com.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seudominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario-ou-apikey
# EMAIL_HOST_PASSWORD=senha-ou-token
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

TIME_ZONE=America/Sao_Paulo

# Frontend usado nos links enviados por email para definição de senha e aprovação digital
FRONTEND_BASE_URL=http://localhost:5173

# Produção / segurança
# Use SECRET_KEY forte e exclusiva quando DEBUG=False.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
LOG_LEVEL=INFO

# WhatsApp / Meta Cloud API
# Essas configurações são lidas pelo backend via .env e não pelo painel administrativo.
